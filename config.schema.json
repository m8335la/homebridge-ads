{
  "pluginAlias": "HomebridgeAds",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "required": ["name", "host", "amsNetIdTarget", "amsNetIdSource", "amsPortTarget"],
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Example Dynamic Platform"
      },
      "host": {
        "title": "Host",
        "type": "string",
        "placeholder": "127.0.0.1"
      },
      "amsNetIdTarget": {
        "title": "AMS Net ID Target",
        "type": "string",
        "placeholder": "127.0.0.1.1.1"
      },
      "amsNetIdSource": {
        "title": "AMS Net ID Source",
        "type": "string",
        "placeholder": "127.0.0.1.1.1"
      },
      "amsPortTarget": {
        "title": "AMS Port",
        "type": "integer",
        "default": "801"
      },
      "accessories": {
        "title": "Accessories",
        "type": "array",
        "items": {
          "title": "Accessory",
          "type": "object",
          "required": ["type", "name", "symname"],
          "properties": {
            "type": {
              "title": "Type",
              "type": "string",
              "oneOf": [
                { "title": "Simple Lightbulb", "enum": ["adsLightbulb"] },
                { "title": "Dimmable Lightbulb", "enum": ["adsDimmableLightbulb"] },
                { "title": "Venetian Blinds", "enum": ["adsVenetianBlindEx1Switch"] },
                { "title": "Thermostat", "enum": ["adsThermostat"] }
              ]
            },
            "name": {
              "title": "Name",
              "type": "string",
              "placeholder": "Name that should be suggested in Home"
            },
            "symname": {
              "title": "Symbol Name",
              "type": "string",
              "placeholder": "Name of the ADS symbol"
            },
            "dhtSensorType": {
              "title": "DHT sensor type",
              "type": "integer",
              "placeholder": "11 or 22"
            },
            "dhtSensorPin": {
              "title": "DHT sensor PIN",
              "type": "integer",
              "placeholder": ""
            }
          }
        }
      }
    }
  }
}
